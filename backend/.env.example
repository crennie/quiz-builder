# Copy to .env.local. The local URL is shown by `npx supabase status` after `npm run db:start`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-publishable-key
PORT=3000
# Required only for npm run worker:content. Keep the token in ignored .env.local.
# AGENT_PROVIDER_URL=https://your-provider.example/generate
# AGENT_PROVIDER_TOKEN=replace-with-provider-token
# AGENT_PROVIDER_NAME=your-provider
# AGENT_PROVIDER_MODEL=your-model
# Optional policy: each role defaults to a human when unset.
# CONTENT_AGENT_REVIEW=true
# CONTENT_AGENT_REVISION=true
# CONTENT_AGENT_GATE=true
# Run one worker per enabled role with AGENT_WORKER_ROLE=review, revision, or gate.
# AGENT_REVIEW_PROVIDER_URL=https://your-provider.example/review
# AGENT_REVIEW_PROVIDER_TOKEN=replace-with-review-token
# AGENT_REVIEW_PROVIDER_NAME=your-review-provider
# AGENT_REVIEW_PROVIDER_MODEL=your-review-model
# AGENT_REVISION_PROVIDER_URL=https://your-provider.example/revise
# AGENT_REVISION_PROVIDER_TOKEN=replace-with-revision-token
# AGENT_REVISION_PROVIDER_NAME=your-revision-provider
# AGENT_REVISION_PROVIDER_MODEL=your-revision-model
# AGENT_GATE_PROVIDER_URL=https://your-provider.example/gate
# AGENT_GATE_PROVIDER_TOKEN=replace-with-gate-token
# AGENT_GATE_PROVIDER_NAME=your-gate-provider
# AGENT_GATE_PROVIDER_MODEL=your-gate-model
