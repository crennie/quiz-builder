{
    "name": "quiz-builder-app",
    "version": "0.0.1",
    "private": true,
    "description": "Quiz Builder backend",
    "type": "module",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "build": "tsc --project tsconfig.build.json",
        "dev": "node --watch src/server.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "start": "node dist/server.js",
        "test": "vitest run",
        "test:integration": "vitest run tests/integration",
        "test:unit": "vitest run tests/unit",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/node": "^24.13.3",
        "@types/supertest": "^7.2.1",
        "eslint": "^10.8.1",
        "prettier": "^3.9.6",
        "supertest": "^7.2.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "express": "^5.2.1",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "zod": "^4.4.3"
    }
}
