                "answerConfig": {
                    "questionType": "multiple_choice_single",
                    "options": [
                        {
                            "id": "a",
                            "text": "Object.hasOwn(child, 'role')"
                        },
                        {
                            "id": "b",
                            "text": "'role' in child"
                        },
                        {
                            "id": "c",
                            "text": "child.role === 'reader'"
                        },
                        {
                            "id": "d",
                            "text": "Reflect.has(child, 'role')"
                        }
                    ],
                    "correctOptionId": "a"
                },
                "gradingConfig": {
                    "questionType": "multiple_choice_single"
