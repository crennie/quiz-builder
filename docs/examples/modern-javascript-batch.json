        {
            "key": "js-03",
            "content": {
                "prompt": "If count is 0, what are count ?? 10 and count || 10, respectively?",
                "questionType": "multiple_choice_single",
                "answerConfig": {
                    "questionType": "multiple_choice_single",
                    "options": [
                        {
                            "id": "a",
                            "text": "10 and 10"
                        },
                        {
                            "id": "b",
                            "text": "0 and 0"
                        },
                        {
                            "id": "c",
                            "text": "10 and 0"
                        },
                        {
                            "id": "d",
                            "text": "0 and 10"
                        }
                    ],
                    "correctOptionId": "d"
                },
                "gradingConfig": {
                    "questionType": "multiple_choice_single"
                },
                "explanation": "The ?? operator substitutes only for null or undefined, so 0 remains 0. Logical OR uses truthiness, so 0 selects the fallback 10."
