{
    "compilerOptions": {
        "target": "ES2024",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2024"],
        "types": ["node"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "declaration": true,
        "outDir": "dist",
        "rootDir": "src",
        "rewriteRelativeImportExtensions": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"]
}
