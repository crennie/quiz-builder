{
    "name": "quiz-builder-tooling",
    "private": true,
    "type": "module",
    "workspaces": [
        "shared"
    ],
    "scripts": {
        "build:shared": "npm run build --workspace=@quiz-builder/contracts",
        "format:check": "prettier --check shared/src shared/package.json shared/tsconfig.json scripts README.md AGENTS.md package.json",
        "typecheck:shared": "npm run typecheck --workspace=@quiz-builder/contracts",
        "test:shared": "npm test --workspace=@quiz-builder/contracts",
        "db:check-schema": "node scripts/check-migration.mjs",
        "db:start": "supabase start",
        "db:reset": "supabase db reset",
        "db:test": "supabase test db",
        "db:types": "node scripts/generate-db-types.mjs"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.8",
        "@types/node": "^24.19.0",
        "prettier": "^3.9.9",
        "supabase": "2.118.0",
        "typescript": "^6.0.3"
    }
}
