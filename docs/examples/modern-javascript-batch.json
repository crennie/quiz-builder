        {
            "key": "js-05",
            "content": {
                "prompt": "One input promise rejects while another is still pending. What happens to the promise returned by Promise.all?",
                "questionType": "multiple_choice_single",
                "answerConfig": {
                    "questionType": "multiple_choice_single",
                    "options": [
                        {
                            "id": "a",
                            "text": "It waits for every input to fulfill"
                        },
                        {
                            "id": "b",
                            "text": "It fulfills with the successful values only"
                        },
                        {
                            "id": "c",
                            "text": "It rejects with the rejection reason, without automatically canceling the other input"
                        },
                        {
                            "id": "d",
                            "text": "It turns the rejection into undefined"
                        }
                    ],
                    "correctOptionId": "c"
                },
                "gradingConfig": {
                    "questionType": "multiple_choice_single"
                },
                "explanation": "Promise.all rejects when an input rejects. This does not itself cancel other promises that were already started."
            }
        },
        {
