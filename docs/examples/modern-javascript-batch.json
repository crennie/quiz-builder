            "key": "js-01",
            "content": {
                "prompt": "After const settings = {theme: 'light'}, which operation is allowed in ordinary JavaScript?",
                "questionType": "multiple_choice_single",
                "answerConfig": {
                    "questionType": "multiple_choice_single",
                    "options": [
                        {
                            "id": "a",
                            "text": "Reassign settings to a different object"
                        },
                        {
                            "id": "b",
                            "text": "Change settings.theme to 'dark'"
                        },
                        {
                            "id": "c",
                            "text": "Redeclare const settings in the same scope"
                        },
                        {
                            "id": "d",
                            "text": "Assign settings = null"
                        }
                    ],
                    "correctOptionId": "b"
                },
                "gradingConfig": {
                    "questionType": "multiple_choice_single"
                },
                "explanation": "const prevents reassignment of the binding, but it does not freeze the object. Changing a property of that object is allowed."
            }
        },
        {
